# Copy this file to `.env` and fill in your PostgreSQL details.
PORT=5000
JWT_SECRET=change-me
APP_TZ=Asia/Kolkata   # timezone for the dashboard's "today" / daily trend

# Environment label shown by /api/health (default: staging on Vercel, production elsewhere).
# APP_ENV=development

# --- Database (first one set wins; see server/db.js) ------------------------
# Staging (Vercel + Prisma Postgres): Vercel adds these to the project automatically when the
# database is connected under Storage. Copy them from there to run locally against staging.
# DATABASE_URL_POOLED is used on Vercel only.
# DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"
# DATABASE_URL_POOLED="postgres://<user>:<password>@pooled.db.prisma.io:5432/postgres?sslmode=require"
# POSTGRES_URL=...   (same database; used if DATABASE_URL is not set)

# Production (Supabase): Project > Connect > "Transaction pooler" connection string.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Local PostgreSQL: leave DATABASE_URL / POSTGRES_URL unset and use the DB_* vars.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=crustandbeyond

# Connections per server process (default 10, or 3 on Vercel).
# DB_POOL_MAX=10
